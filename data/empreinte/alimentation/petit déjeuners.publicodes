alimentation . petit déjeuner:
  titre: Petit déjeuner
  icônes: 🥐
  formule: petit déjeuner . par jour * commun . jours par an / 1 jour

alimentation . petit déjeuner . par semaine:
  titre: Empreinte hebdo petit déjeuner
  formule: par jour * commun . jours par semaine

alimentation . petit déjeuner . par jour:
  DLUO: 01/06/2026
  titre: Empreinte quotidienne petit déjeuner
  icônes: 🥐
  mosaique:
    type: selection
    options:
      - tartine . présent
      - viennoiserie . présent
      - bol céréales . présent
      - yaourt . présent
      - fruits . présent
      - oeufs . présent
      - charcuterie . présent
      - fromage . présent
    suggestions:
      fruits et tartines:
        tartine . présent: oui
        viennoiserie . présent: non
        bol céréales . présent: non
        yaourt . présent: non
        fruits . présent: oui
        oeufs . présent: non
        charcuterie . présent: non
        fromage . présent: non
      lait et céréales:
        tartine . présent: non
        viennoiserie . présent: non
        bol céréales . présent: oui
        yaourt . présent: non
        fruits . présent: non
        oeufs . présent: non
        charcuterie . présent: non
        fromage . présent: non
      oeufs et charcuterie:
        tartine . présent: non
        viennoiserie . présent: non
        bol céréales . présent: non
        yaourt . présent: non
        fruits . présent: non
        oeufs . présent: oui
        charcuterie . présent: oui
        fromage . présent: non
      végétalien:
        tartine . présent: non
        viennoiserie . présent: non
        bol céréales . présent: non
        yaourt . présent: non
        fruits . présent: oui
        oeufs . présent: non
        charcuterie . présent: non
        fromage . présent: non
    option aucun: aucun
  question: Que mangez-vous le matin en général ?
  description: |
    Votre consommation de jus de fruits / café / thé / chocolat chaud sera comptabilisée dans les questions dédiées aux boissons.
  formule:
    somme:
      - tartine
      - viennoiserie
      - bol céréales
      - yaourt
      - fruits
      - oeufs
      - charcuterie
      - fromage

alimentation . petit déjeuner . tartine:
  titre: Tartine
  icônes: 🥖
  description: |
    Pain, beurre ou autres tartinable
  applicable si: tartine . présent
  formule:
    somme:
      - pain
      - beurre
      - pate à tartiner
      - confiture

alimentation . petit déjeuner . tartine . présent:
  question: Votre petit déjeuner est-il composé d'une tartine ?
  par défaut: oui

alimentation . petit déjeuner . tartine . pain:
  formule: empreinte pain * 0.050 kg

alimentation . petit déjeuner . tartine . empreinte pain:
  formule:
    variations:
      - si: métrique = "carbone"
        alors: empreinte carbone pain
      - si: métrique = "eau"
        alors: empreinte eau pain

alimentation . petit déjeuner . tartine . empreinte carbone pain:
  valeur: 0.78
  unité: kgCO2e/kg
  note: Facteur d'émission issu d'[Agribalyse, Pain, baguette, courante](https://agribalyse.ademe.fr/app/aliments/7001#Pain,_baguette,_courante).

