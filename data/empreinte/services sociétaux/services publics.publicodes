# Ce fichier a été généré automatiquement via le script 'scripts/generate_services_rules.js' dans le dépôt nosgestesclimat.
# Le fichier permettant de modifier les données importantes de répartition et justification des services sociétaux
# est 'scripts/services-societaux/input/répartition_services_sociétaux.yaml'. Pour en savoir plus, n'hésitez pas à parcourir notre guide !

services sociétaux . services publics:
  public: oui
  abréviation: S. publics
  description: |-
    Les services publics ne sont qu'une partie des [services sociétaux](https://nosgestesclimat.fr/documentation/services-soci%C3%A9taux) dont le calcul est basé sur
    [l'estimation de l'empreinte nationale française par le Ministère de l'Écologie](https://www.statistiques.developpement-durable.gouv.fr/lempreinte-carbone-de-la-france-de-1995-2021).
  formule:
    somme:
      - investissements administratifs activités diverses
      - pharmacie
      - réseau distribution eau
      - traitement eaux usées
      - gestion déchets dangereux
      - assainissement batiments et sites contaminés
      - construction bâtiments et ouvrages publics
      - activités juridiques et conseil
      - architecture et contrôle du bâti
      - recherche et développement scientifique
      - activités liées à l'emploi
      - administration publique et défense
      - éducation
      - santé
      - culture
      - autres services
  icônes: 🏛
  non applicable si: métrique != "carbone"
  titre: Services publics

services sociétaux . services publics . investissements administratifs activités diverses:
  formule:
    somme:
      - empreinte branche . B05 par hab . services publics
      - empreinte branche . B06 par hab . services publics
      - empreinte branche . B07 par hab . services publics
      - empreinte branche . B08 par hab . services publics
      - empreinte branche . B09 par hab . services publics
      - empreinte branche . C25 par hab . services publics
      - empreinte branche . C26 par hab . services publics
      - empreinte branche . C27 par hab . services publics
      - empreinte branche . C28 par hab . services publics
      - empreinte branche . C29 par hab . services publics
      - empreinte branche . C31 par hab . services publics
      - empreinte branche . C32 par hab . services publics
      - empreinte branche . C33 par hab . services publics

