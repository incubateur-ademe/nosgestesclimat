bilan . sous catégories . transport . voiture:

bilan . sous catégories . transport . voiture . usage:
  formule:
    variations:
      - si:
          toutes ces conditions:
            - est défini: transport . voiture . utilisateur
            - transport . voiture . utilisateur = 'jamais'
        alors: 0
      - si:
          est défini: transport . voiture . utilisateur
        alors:
          variations:
            - si:
                une de ces conditions:
                  - transport . voiture . utilisateur = 'propriétaire'
                  - transport . voiture . utilisateur = 'régulier non propriétaire'
              alors: transport . voiture . usage / transport . voiture . voyageurs
            - si: transport . voiture . utilisateur = 'non régulier'
              alors:
                valeur: transport . voiture . usage / transport . voiture . voyageurs
                contexte:
                  transport . voiture . utilisateur: "'régulier non propriétaire'"
                  transport . voiture . gabarit: "'moyenne'"
                  transport . voiture . motorisation: "'thermique'"
                  transport . voiture . thermique . carburant: "'essence E5 ou E10'"
                  transport . voiture . thermique . consommation aux 100:
                    valeur: transport . voiture . thermique . consommation estimée
                    contexte:
                      transport . voiture . utilisateur: "'régulier non propriétaire'"
                      transport . voiture . gabarit: "'moyenne'"
                      transport . voiture . motorisation: "'thermique'"
                      transport . voiture . thermique . carburant: "'essence E5 ou E10'"
      - sinon:
          valeur: transport . voiture . usage / transport . voiture . voyageurs
          contexte:
            transport . voiture . voyageurs: transport . voiture . voyageurs . nombre moyen
            transport . voiture . km: transport . voiture . km annuels moyen réel
            transport . voiture . utilisateur: "'propriétaire'"
            transport . voiture . gabarit: "'moyenne'"
            transport . voiture . motorisation: "'thermique'"
            transport . voiture . thermique . carburant: "'essence E5 ou E10'"
            transport . voiture . thermique . consommation aux 100:
              valeur: transport . voiture . thermique . consommation estimée
              contexte:
                transport . voiture . utilisateur: "'propriétaire'"
                transport . voiture . gabarit: "'moyenne'"
                transport . voiture . motorisation: "'thermique'"
                transport . voiture . thermique . carburant: "'essence E5 ou E10'"

bilan . sous catégories . transport . voiture . construction:
  formule:
    variations:
      - si:
          toutes ces conditions:
            - est défini: transport . voiture . utilisateur
            - transport . voiture . utilisateur = 'jamais'
        alors: 0
      - si:
          est défini: transport . voiture . utilisateur
        alors:
          variations:
            - si:
                une de ces conditions:
                  - transport . voiture . utilisateur = 'propriétaire'
                  - transport . voiture . utilisateur = 'régulier non propriétaire'
              alors: transport . voiture . construction / transport . voiture . voyageurs
            - si: transport . voiture . utilisateur = 'non régulier'
              alors:
                valeur: transport . voiture . construction / transport . voiture . voyageurs
                contexte:
                  transport . voiture . utilisateur: "'régulier non propriétaire'"
                  transport . voiture . gabarit: "'moyenne'"
                  transport . voiture . motorisation: "'thermique'"
                  transport . voiture . thermique . carburant: "'essence E5 ou E10'"
                  transport . voiture . thermique . consommation aux 100:
                    valeur: transport . voiture . thermique . consommation estimée
                    contexte:
                      transport . voiture . utilisateur: "'régulier non propriétaire'"
                      transport . voiture . gabarit: "'moyenne'"
                      transport . voiture . motorisation: "'thermique'"
                      transport . voiture . thermique . carburant: "'essence E5 ou E10'"
      - sinon:
          valeur: transport . voiture . construction / transport . voiture . voyageurs
          contexte:
            transport . voiture . voyageurs: transport . voiture . voyageurs . nombre moyen
            transport . voiture . km: transport . voiture . km annuels moyen réel
            transport . voiture . utilisateur: "'propriétaire'"
            transport . voiture . gabarit: "'moyenne'"
            transport . voiture . motorisation: "'thermique'"
            transport . voiture . thermique . carburant: "'essence E5 ou E10'"
            transport . voiture . thermique . consommation aux 100:
              valeur: transport . voiture . thermique . consommation estimée
              contexte:
                transport . voiture . utilisateur: "'propriétaire'"
                transport . voiture . gabarit: "'moyenne'"
                transport . voiture . motorisation: "'thermique'"
                transport . voiture . thermique . carburant: "'essence E5 ou E10'"

bilan . sous catégories . transport . avion:

bilan . sous catégories . transport . avion . court courrier:
  formule:
    variations:
      - si:
          est défini: transport . avion . usager
        alors:
          somme:
            - transport . avion . vols annuels . heures court courrier * transport . avion . court courrier . empreinte par km * transport . avion . court courrier . vitesse moyenne
            - transport . avion . vols amortis . heures court courrier * transport . avion . court courrier . empreinte par km * transport . avion . court courrier . vitesse moyenne
      - sinon: transport . avion . court courrier . durée moyenne * transport . avion . court courrier . empreinte par km * transport . avion . court courrier . vitesse moyenne

