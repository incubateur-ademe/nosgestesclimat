bilan . sous catégories . logement . chauffage:
bilan . sous catégories . logement . chauffage . moyenne:
  formule:
    variations:
      - si:
          est non défini: logement . chauffage . mode
        alors: logement . chauffage . empreinte par défaut / logement . habitants
      - sinon: 0

bilan . sous catégories . logement . chauffage . gaz:
  formule:
    variations:
      - si:
          toutes ces conditions:
            - est défini: logement . chauffage . mode
            - logement . chauffage . mode = "individuel"
            - est défini: logement . chauffage . principal
        alors: logement . chauffage . gaz . empreinte / logement . habitants
      - si:
          toutes ces conditions:
            - est défini: logement . chauffage . mode
            - logement . chauffage . mode = "collectif"
        alors:
          valeur: logement . chauffage . gaz . empreinte / logement . habitants
          contexte:
            logement . chauffage . saisie précision consommation: "'aide'"
            logement . chauffage . précision consommation . ressenti: "'moyen'"
      - si:
          toutes ces conditions:
            - est défini: logement . chauffage . mode
            - logement . chauffage . mode = "pas de chauffage"
        alors: 0
      - sinon: 0

